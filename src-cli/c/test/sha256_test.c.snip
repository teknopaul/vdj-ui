#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "../lib/sha256.h"

//SNIP_FILE SNIP_sha256 ../lib/sha256.c

#include "snip_core.h"

static void vec(const char *msg, const char *data, size_t len, const char *expected)
{
    char hex[65];
    tc_sha256_hex(data, len, hex);
    if (strcmp(hex, expected) != 0) {
        char m[300];
        errors++;
        snprintf(m, sizeof m, "%s: expected %s got %s", msg, expected, hex);
        snip_error(m);
    }
}

int main(void)
{
    /* FIPS 180-4 / NIST examples */
    vec("empty", "", 0, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    vec("abc", "abc", 3, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    vec("two blocks", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", 56,
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
    vec("one letter", "a", 1, "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb");
    {
        /* one million 'a', fed in odd sized pieces: the block buffering */
        struct tc_sha256 c;
        uint8_t d[32], buf[1000];
        char hex[65];
        int i;
        size_t chunk[] = { 1, 63, 64, 65, 1000, 7 };

        memset(buf, 'a', sizeof buf);
        tc_sha256_init(&c);
        for (i = 0; i < 1000; i++) {
            tc_sha256_update(&c, buf, 1000);
        }
        tc_sha256_final(&c, d);
        for (i = 0; i < 32; i++) {
            sprintf(hex + i * 2, "%02x", d[i]);
        }
        snip_assert("a million a", strcmp(hex, "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0") == 0);

        /* the same message in uneven chunks gives the same hash as in one piece */
        {
            const char *msg = "The quick brown fox jumps over the lazy dog";
            char one[65], pieces[65];
            size_t off = 0, k = 0, len = strlen(msg);
            tc_sha256_hex(msg, len, one);
            tc_sha256_init(&c);
            while (off < len) {
                size_t n = chunk[k++ % 6] % 5 + 1;
                if (off + n > len) { n = len - off; }
                tc_sha256_update(&c, msg + off, n);
                off += n;
            }
            tc_sha256_final(&c, d);
            for (i = 0; i < 32; i++) {
                sprintf(pieces + i * 2, "%02x", d[i]);
            }
            snip_assert("chunked equals whole", strcmp(one, pieces) == 0);
            snip_assert("fox", strcmp(one, "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592") == 0);
        }
    }
    {
        char hex[65];
        snip_assert("file: missing", tc_sha256_file("/tmp/nonesuch/zzz", hex) != 0);
        FILE *f = fopen("/tmp/tc_sha256_test.bin", "wb");
        fwrite("abc", 1, 3, f);
        fclose(f);
        snip_equals("file", 0, tc_sha256_file("/tmp/tc_sha256_test.bin", hex));
        snip_assert("file: abc", strcmp(hex, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") == 0);
        remove("/tmp/tc_sha256_test.bin");
    }
    if (errors) { printf("%d errors\n", errors); return 1; }
    printf("sha256: all ok\n");
    return 0;
}
