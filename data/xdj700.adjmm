# adj midi map — Pioneer XDJ-700
#
# Pioneer XDJ-700 uses channel 1, NoteOn events for buttons
# Controller 80: 127 = keydown, 0 = keyup
#
# name          ch  ctrl  val   # comment
start           1   N     0     # play button
stop            1   N     1     # cue button
toggle          1   N     2     # play/pause toggle

nudge_fwd       1   48    +     # platter jog forward
nudge_rew       1   48    -     # platter jog backward
nudge_ffwd      1   48    ++    # platter fast forward
nudge_frew      1   48    --    # platter fast reverse

tempo_inc_1     1   N     10    # tempo +1.0
tempo_inc       1   N     11    # tempo +0.1
tempo_inc_min   1   N     12    # tempo +0.01
tempo_dec_1     1   N     13    # tempo -1.0
tempo_dec       1   N     14    # tempo -0.1
tempo_dec_min   1   N     15    # tempo -0.01

copy_master     1   N     16    # copy BPM from master deck
become_master   1   N     17    # become tempo master
